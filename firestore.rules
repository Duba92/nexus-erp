rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'GUEST';
    }

    function getUserCompanyId() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.companyId : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'SUPER_ADMIN';
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (isSuperAdmin() || getUserCompanyId() == companyId);
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.fullName is string && data.fullName.size() <= 200 &&
               data.phone is string && data.phone.size() <= 20 &&
               data.role in ['SUPER_ADMIN', 'COMPANY_ADMIN', 'MANAGER', 'CASHIER', 'EMPLOYEE'] &&
               (data.createdAt is timestamp || data.createdAt == null);
      }

      allow read: if true; // Open for login repair queries
      
      allow create: if isSignedIn() && (
        isOwner(userId) || 
        isSuperAdmin() || 
        (getUserRole() == 'COMPANY_ADMIN' && request.resource.data.companyId == getUserCompanyId())
      ) && isValidUser(request.resource.data);
      
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        isSuperAdmin() || 
        (getUserRole() == 'COMPANY_ADMIN' && resource.data.companyId == getUserCompanyId())
      ) && isValidUser(request.resource.data);
      
      allow delete: if isSuperAdmin();
    }

    // 2. Companies Collection
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || (getUserRole() == 'COMPANY_ADMIN' && getUserCompanyId() == companyId));
      allow delete: if isSuperAdmin();
    }

    // Generic match for company-owned data
    match /{collection}/{id} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (resource != null && resource.data.companyId == getUserCompanyId())
      );
      
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        (request.resource != null && request.resource.data.companyId == getUserCompanyId()) ||
        (resource != null && resource.data.companyId == getUserCompanyId())
      );
    }

  }
}
